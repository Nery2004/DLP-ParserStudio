%token ARRANCA GOL PASE MARCA GRITA FIN NUMBER STRING ID SEMI
%ignore WS
%start script

%%
script : ARRANCA SEMI body ;
body : FIN SEMI
     | command body ;
command : goal
        | pass
        | mark
        | shout ;
goal : GOL ID SEMI ;
pass : PASE ID ID SEMI ;
mark : MARCA ID NUMBER SEMI ;
shout : GRITA STRING SEMI ;
